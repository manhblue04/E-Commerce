# Frontend Environment Variables
# Copy this file to .env and fill in your values

# ─── API URL ───────────────────────────────────────────────────────────────
# Dùng "/api" để đi qua Vite proxy — hoạt động cả dev lẫn production.
# KHÔNG cần đổi biến này khi chuyển môi trường.
VITE_API_URL=/api

# ─── Backend Proxy Target ───────────────────────────────────────────────────
# Chỉ ảnh hưởng đến Vite dev-server proxy (vite.config.js đọc biến này).
# Dev:        http://localhost:5000
# Production: http://blue304.shop:5000  (hoặc domain thật)
VITE_BACKEND_URL=http://localhost:5000

# ─── Google OAuth ───────────────────────────────────────────────────────────
# Lấy từ: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# ─── Stripe (tuỳ chọn) ─────────────────────────────────────────────────────
# Lấy từ: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
