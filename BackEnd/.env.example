# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/fashion_store

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=1d

# Frontend URL — used ONLY for email links (verify, reset password, order tracking)
# Dev:        http://localhost  (if Vite runs on port 80)
# Production: http://blue304.shop  or  https://yourdomain.com
FRONTEND_URL=http://localhost

# CORS origins — comma-separated list of all allowed frontend origins
# Dev:        http://localhost
# Production: http://localhost,http://blue304.shop
CLIENT_URL=http://localhost

# Backend server URL (for payment IPN callbacks — must be publicly reachable)
# For local development: http://localhost:5000
# For production: https://api.yourdomain.com
SERVER_URL=http://localhost:5000

# Email/SMTP Configuration
# For Gmail: Use App Password (not your regular password)
# Get it from: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Cloudinary (Image upload)
# Get credentials from: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google OAuth (for Google Login)
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Payment Gateways (Optional - for production)
VNPAY_TMN_CODE=
VNPAY_SECRET_KEY=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# Stripe (International payments)
# Get credentials from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# AI Chat Assistant (for auto-reply in messaging)
# Provider: openai or gemini
# Gemini (free): Get API key from https://aistudio.google.com/apikey
# OpenAI (paid): Get API key from https://platform.openai.com/api-keys
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-2.5-flash
